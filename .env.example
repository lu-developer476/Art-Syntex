VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

VITE_API_BASE_URL=http://localhost:3001

PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-FIREBASE-HOSTING-DOMAIN
APP_BASE_URL=http://localhost:5173

# SMTP credentials (server only). Default sender is the project's Gmail inbox.
EMAIL_USER=lucasmontenegroburgos@gmail.com
EMAIL_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Current sender/recipient addresses. These can be changed independently later.
CONTACT_RECEIVER_EMAIL=lucasmontenegroburgos@gmail.com
ORDER_RECEIVER_EMAIL=lucasmontenegroburgos@gmail.com
CONTACT_FROM=lucasmontenegroburgos@gmail.com
CONTACT_REPLY_TO=lucasmontenegroburgos@gmail.com
NEWSLETTER_FROM=lucasmontenegroburgos@gmail.com
REGISTRATION_FROM=lucasmontenegroburgos@gmail.com

# Future custom-domain example (replace with verified sender addresses and provider SMTP details):
# SMTP_HOST=smtp.your-email-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_USER=your-provider-smtp-user
# EMAIL_PASS=your-provider-smtp-password
# CONTACT_FROM=contacto@art-syntex.net
# CONTACT_REPLY_TO=contacto@art-syntex.net
# CONTACT_RECEIVER_EMAIL=contacto@art-syntex.net
# NEWSLETTER_FROM=newsletters@art-syntex.net
# REGISTRATION_FROM=contacto@art-syntex.net

# Firebase Admin SDK — server only. Never expose these as VITE_* variables.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
