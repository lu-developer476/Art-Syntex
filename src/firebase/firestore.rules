rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidNewsletterSubscription() {
      return request.resource.data.keys().hasAll(['email', 'consent', 'source', 'consentedAt'])
        && request.resource.data.keys().hasOnly(['email', 'consent', 'source', 'consentedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('.*@.*[.].*')
        && request.resource.data.consent == true
        && request.resource.data.source == 'contact-page'
        && request.resource.data.consentedAt == request.time;
    }

    function isValidNewsletterSubscriptionUpdate() {
      return request.resource.data.keys().hasAll(['email', 'consent', 'source', 'consentedAt'])
        && request.resource.data.keys().hasOnly([
          'email',
          'consent',
          'source',
          'consentedAt',
          'status',
          'welcomeEmailStatus',
          'welcomeEmailClaimedAt',
          'welcomeEmailSentAt',
          'updatedAt'
        ])
        && request.resource.data.email == resource.data.email
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('.*@.*[.].*')
        && request.resource.data.consent == true
        && request.resource.data.source == 'contact-page'
        && request.resource.data.consentedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'consent',
          'source',
          'consentedAt'
        ]);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2030, 1, 1);
    }

    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read, update, delete: if isOwner(uid);
    }

    match /purchaseOrders/{orderId} {
      allow create: if false; // Purchase orders are created only by the trusted serverless API.
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /newsletterSubscribers/{subscriberId} {
      allow create: if isValidNewsletterSubscription();
      allow update: if isValidNewsletterSubscriptionUpdate();
      allow read, delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
