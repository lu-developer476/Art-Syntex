rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2030, 1, 1);
    }

    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read, update, delete: if isOwner(uid);
    }

    match /purchaseOrders/{orderId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    function isValidNewsletterSubscription() {
      return request.resource.data.keys().hasAll(['email', 'consent', 'source', 'consentedAt'])
        && request.resource.data.keys().hasOnly(['email', 'consent', 'source', 'consentedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
)
        && request.resource.data.consent == true
        && request.resource.data.source == 'contact-page'
        && request.resource.data.consentedAt == request.time;
    }

    match /newsletterSubscribers/{subscriberId} {
      allow create: if isValidNewsletterSubscription();
      allow update: if isValidNewsletterSubscription()
        && request.resource.data.email == resource.data.email;
      allow read, delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
